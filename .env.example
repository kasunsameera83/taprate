# Public URL of the app, no trailing slash. Used for links in snippets and for the same-origin (CSRF) check.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never expose to the browser. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SERVER ONLY. Secrets for signing survey links and response tokens.
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LINK_SIGNING_SECRET=
# Optional: set to the old secret while rotating, so links already in sent emails keep working.
LINK_SIGNING_SECRET_PREVIOUS=
RESPONSE_TOKEN_SECRET=
# Used to hash IP addresses before storing them (we never store raw IPs).
IP_HASH_SALT=

# Optional: alert emails via Resend (https://resend.com). Alerts are skipped if empty.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Optional: protects the daily overdue follow-up reminder (/api/cron/followups). Generate like the secrets above.
CRON_SECRET=

# Optional: billing. Each provider is switched on only when its settings are filled in.
# PayHere (LKR): Merchant ID and Merchant Secret from PayHere -> Settings -> Domains & Credentials.
# Use a sandbox account (https://sandbox.payhere.lk) until you go live, and keep PAYHERE_SANDBOX=true.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
# Needed to cancel PayHere subscriptions from TapTruly (PayHere -> Settings -> API Keys, "Subscription Manager").
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
# Stripe (USD): secret key from Dashboard -> Developers -> API keys; webhook signing secret from the
# webhook endpoint you add for https://YOUR-DOMAIN/api/webhooks/stripe (or `stripe listen` locally).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: AI summaries of customer comments (Claude API key from https://console.anthropic.com).
# Owners must also switch AI summaries on for their business. The default model is fast and low-cost.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: error monitoring with Sentry (sentry.io -> project -> Settings -> Client Keys (DSN)).
# Errors are always written to the server logs; with a DSN they're also sent to Sentry (scrubbed of personal data).
SENTRY_DSN=
