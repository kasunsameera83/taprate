# Public URL of the app, no trailing slash. Used for links in snippets and for the same-origin (CSRF) check.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never expose to the browser. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SERVER ONLY. Secrets for signing survey links and response tokens.
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LINK_SIGNING_SECRET=
# Optional: set to the old secret while rotating, so links already in sent emails keep working.
LINK_SIGNING_SECRET_PREVIOUS=
RESPONSE_TOKEN_SECRET=
# Used to hash IP addresses before storing them (we never store raw IPs).
IP_HASH_SALT=

# Optional: alert emails via Resend (https://resend.com). Alerts are skipped if empty.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com
